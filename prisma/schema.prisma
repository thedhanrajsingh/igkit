generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  /// Encrypted with encryptToken; powers the dashboard AI insights card.
  openrouterApiKey  String?

  zernioConnection  ZernioConnection?
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  bioPage           BioPage?
  aiInsights        AiInsight[]

  @@index([ownerId])
}

/// Feed of AI-generated dashboard insights, newest first.
model AiInsight {
  id          String    @id @default(cuid())
  workspaceId String
  text        String
  /// The model OpenRouter's router actually picked, e.g. "openai/gpt-6-luna".
  model       String
  /// Tools the agent called before answering, e.g. ["list_campaigns"].
  toolsUsed   String[]  @default([])
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  suggestions AiSuggestion[]

  @@index([workspaceId, createdAt])
}

/// A campaign change the agent proposed. Nothing changes until a person applies it.
model AiSuggestion {
  id           String     @id @default(cuid())
  insightId    String
  automationId String
  /// "dm_message" | "add_keywords" | "pause"
  kind         String
  /// New DM text, or the keywords to add (JSON array). Empty for pause.
  value        String
  reason       String
  /// "PENDING" | "APPLIED" | "DISMISSED"
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  insight      AiInsight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([insightId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  provider          InstagramProvider @default(META)
  zernioAccountId   String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]
  followerSnapshots FollowerSnapshot[]

  @@index([workspaceId])
}

/// Daily follower total per account. Instagram keeps only ~30 days of insights,
/// so older history exists only because we record it here.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire on DMs matching the keywords. A DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  aiSuggestions    AiSuggestion[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // Public reply is tracked separately from the DM: publicReplySentAt keeps it
  // idempotent across retries, and a DM failure never blocks or re-posts it.
  dmDeliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Legacy and unwired: nothing reads or writes ProcessedComment. Reconciliation
// dedups via owner-reply checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // 0-based DM button index. Sort with TRACKED_LINK_ORDER, never createdAt alone:
  // links saved in one request share a createdAt and ties come back unordered.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum InstagramProvider {
  META
  ZERNIO
}

model ZernioConnection {
  workspaceId    String @id
  apiKey         String
  profileId      String?
  webhookId      String?
  webhookSecret  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}

/// Public link-in-bio page, one per workspace, served at /<handle>.
model BioPage {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  handle      String   @unique
  title       String
  bio         String?
  avatarUrl   String?
  theme       String   @default("light")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links     BioLink[]
}

model BioLink {
  id        String   @id @default(cuid())
  bioPageId String
  title     String
  url       String
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  bioPage BioPage @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  @@index([bioPageId, position])
}
